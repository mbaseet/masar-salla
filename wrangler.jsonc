{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masar-salla",
  "main": "build/worker.ts",
  "account_id": "b9e9dea4a313b1d088ef818aac0e3e1e",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [{"binding":"DB", "database_name":"masar-salla-db", "database_id":"04d142d4-c304-442c-8542-f7b774aa28c4", "migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET", "bucket_name":"masar-salla-waybills"}],
  "triggers": {"crons":["0 * * * *"]},
  "observability": {"enabled":false}
}
